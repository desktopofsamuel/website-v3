#!/bin/sh
# Auto-fix staged PNGs under public/static/ with lossless oxipng, then re-stage.
# Fails if one of those PNGs is staged and oxipng is not installed.
# Install: brew install oxipng | cargo install oxipng
# Ubuntu/Debian apt does not ship oxipng; use https://github.com/oxipng/oxipng/releases

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
exec node scripts/optimize-staged-pngs.mjs
